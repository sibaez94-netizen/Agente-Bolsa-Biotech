# Configuración de envío diario por Email (las mismas claves de Gmail que en Solares)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_de_16_letras
NOTIFY_EMAIL=tu_correo@gmail.com

# URL pública de tu GitHub Pages cuando actives el repositorio
DASHBOARD_URL=https://sibaez94-netizen.github.io/radar-bolsa-biotech/

# Opcional: Clave de Google AI Studio (Gemini) para redactar el parte diario con el Prompt Maestro
GEMINI_API_KEY=

# Opcional: Bot de Telegram (@BotFather) si también quieres recibir el aviso en Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
